# VentDepot — production .env  (copy to /var/www/ventdepot/.env and fill in)
APP_ENV=production
APP_TIMEZONE=America/Mexico_City
APP_URL=https://ventdepot.com

# --- Database (from 01-provision-server.sh output) ---
DB_HOST=127.0.0.1
DB_NAME=ventdepot
DB_USER=ventdepot
DB_PASS=CHANGE_ME

# --- PayPal: two business accounts, routed by shipping country ---
PAYPAL_US_CLIENT_ID=
PAYPAL_US_SECRET=
PAYPAL_MX_CLIENT_ID=
PAYPAL_MX_SECRET=
PAYPAL_MX_CURRENCY=USD          # set MXN to charge Mexican customers in pesos
PAYPAL_MODE=sandbox             # flip to "live" only after a sandbox test order

# --- OXXO cash vouchers ---
OXXO_WEBHOOK_SECRET=            # shared secret for api/oxxo-webhook.php (PSP)

# --- Shipping ---
GOOGLE_MAPS_API_KEY=            # real driving distance; estimates used if blank
SHIPPING_ORIGIN_ADDRESS="Your warehouse street, City, State, Mexico"

# --- Email (SmtpMailer is built in; no library needed) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ventdepot.com
MAIL_FROM_NAME="VentDepot"
