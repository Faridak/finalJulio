# VentDepot — production .env  (copy to /var/www/ventdepot/.env and fill in)
# chmod 640 .env && chown root:www-data .env
# Values with spaces or " #" must be quoted. Unquoted " # text" is a comment.
APP_ENV=production
APP_TIMEZONE=America/Mexico_City
APP_URL=https://ventdepot.com

# --- Database (from 01-provision-server.sh output) ---
# Names must match config/database.php (the old DB_NAME/DB_USER/DB_PASS keys
# were never read, so the app fell back to root with no password).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ventdepot
DB_USERNAME=ventdepot
DB_PASSWORD=CHANGE_ME

# --- PayPal: two business accounts, routed by shipping country ---
PAYPAL_US_CLIENT_ID=
PAYPAL_US_SECRET=
PAYPAL_MX_CLIENT_ID=
PAYPAL_MX_SECRET=
PAYPAL_MX_CURRENCY=USD          # set MXN to charge Mexican customers in pesos
PAYPAL_MODE=sandbox             # flip to "live" only after a sandbox test order

# --- OXXO cash vouchers ---
# Shared secret for api/oxxo-webhook.php — generate: openssl rand -hex 32
OXXO_WEBHOOK_SECRET=

# --- Public REST API (api/router.php) — unfinished, keep off ---
API_ENABLED=false
# Only needed if API_ENABLED=true. At least 32 random chars: openssl rand -hex 32
JWT_SECRET=

# --- Shipping ---
GOOGLE_MAPS_API_KEY=            # real driving distance; estimates used if blank
SHIPPING_ORIGIN_ADDRESS="Your warehouse street, City, State, Mexico"

# --- Email (SmtpMailer is built in; no library needed) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ventdepot.com
MAIL_FROM_NAME="VentDepot"

# --- Media object storage (Linode Object Storage, S3-compatible) ---
# Cut-over order: 1) STORAGE_DRIVER=s3 + S3_* keys  2) php scripts/migrate-images-to-object-storage.php
# 3) only then set ASSET_BASE_URL (and SetEnv ASSET_ORIGIN to the same URL in the Apache vhost).
STORAGE_DRIVER=local            # local | s3
S3_ENDPOINT=https://us-ord-1.linodeobjects.com
S3_REGION=us-ord-1
S3_BUCKET=ventdepot-media
S3_KEY=
S3_SECRET=
ASSET_BASE_URL=                 # empty = serve images from this server
