# Application Configuration
APP_NAME=VentDepot
APP_ENV=production
APP_TIMEZONE=America/Mexico_City
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ventdepot
DB_USERNAME=ventdepot_user
DB_PASSWORD=your_strong_password

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# Stripe Configuration
STRIPE_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET=sk_test_your_stripe_secret_key

# PayPal Configuration — two business accounts routed by shipping country
# Mexico customers -> PayPal Mexico; everyone else -> PayPal USA
PAYPAL_US_CLIENT_ID=your_paypal_usa_client_id
PAYPAL_US_SECRET=your_paypal_usa_secret
PAYPAL_MX_CLIENT_ID=your_paypal_mexico_client_id
PAYPAL_MX_SECRET=your_paypal_mexico_secret
PAYPAL_MX_CURRENCY=USD   # set MXN to charge Mexican customers in pesos
PAYPAL_MODE=sandbox      # sandbox | live (applies to both accounts)

# Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_mailgun_username
MAIL_PASSWORD=your_mailgun_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=VentDepot

# Security Configuration
SESSION_LIFETIME=120
SECURITY_SALT=your_random_salt_here
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Logging Configuration
LOG_CHANNEL=stack
LOG_LEVEL=warning

# API Configuration
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=3600

# File Storage
STORAGE_DISK=local
STORAGE_ROOT=storage/app/public

# Caching
CACHE_DRIVER=redis
CACHE_PREFIX=ventdepot

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Queue Configuration
QUEUE_CONNECTION=redis

# Broadcasting
BROADCAST_DRIVER=redis

# Other Services
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
# Shipping calculation (own DHL-style tariff + Google Maps distance)
GOOGLE_MAPS_API_KEY=your_google_maps_key   # enables real driving distance; estimates used until set
SHIPPING_ORIGIN_ADDRESS="Mexico City, CDMX, Mexico"   # your warehouse

# OXXO cash payments — set when the PSP (Conekta/Openpay) webhook is connected
OXXO_WEBHOOK_SECRET=your_oxxo_webhook_secret
